<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 clock-in widget: status pill, live timer, detail line and the action button.
     The timer is a Chronometer, so it ticks on its own without waking the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_off"
        android:fontFamily="sans-serif-black"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="@string/widget_out"
        android:textAllCaps="true"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp" />

    <Chronometer
        android:id="@+id/w_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:text="@string/widget_idle"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp" />

    <!-- Spacer (a plain View is not allowed in RemoteViews) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/w_action"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/widget_btn_in"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="@string/widget_clock_in"
        android:textColor="#FF0C0C12"
        android:textSize="14sp" />
</LinearLayout>
