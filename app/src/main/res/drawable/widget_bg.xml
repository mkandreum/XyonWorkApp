<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget card: the app's blue field, large rounded corners, hairline highlight -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF2F6BF2" android:endColor="#FF1733C4" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
